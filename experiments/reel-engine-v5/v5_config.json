    "private_preview": {
      "dimensions": [
        720,
        1280
      ],
      "fps": 24,
      "codec": "h264",
      "audio": "aac",
      "status": "v4_1_real_footage_verified",
      "audio_source": "approved existing recording, do not generate substitute"
