{
  "version": "6.0.0-dev",
  "release_status": "source_only_no_production_switch",
  "provider_policy": {
    "mode": "gemini_plus_groq",
    "gemini_auth": "GEMINI_API_KEY",
    "gemini_account_note": "Free tier model list published; API key project tier/billing must be verified separately",
    "gemini_role": "research_and_source_visual_observations",
    "gemini_model_selection": "highest_available_free_flash_generateContent_from_live_model_list",
    "groq_auth": "REEL_ENGINE_KEY",
    "allow_paid_inference": false,
    "external_media_requires_explicit_owner_consent": true,
    "cross_provider_fallback": false,
    "gemini_free_tier_models": [
      "gemini-3.8-flash",
      "gemini-3.7-flash",
      "gemini-3.6-flash",
      "gemini-3.5-flash",
      "gemini-3.5-flash-lite",
      "gemini-3.1-flash-lite"
    ],
    "require_verified_free_project": true,
    "gemini_privacy": "Only consented FilmCraft-native JPEG frame samples, source timestamps, and human-reviewed textual shot descriptions are sent to Gemini. No entire video, private URL, or original audio is transmitted.",
    "owner_approved_free_flash_inference": true
  },
  "model_roles": {
    "research": {
      "provider": "gemini",
      "model": "discover_free_flash_model_at_runtime",
      "allow_flash_fallback": true,
      "require_no_private_video_upload": true,
      "frame_policy": {
        "source": "FilmCraft file.exportFrame",
        "max_frames": 3,
        "max_combined_bytes": 3145728,
        "requires_explicit_owner_consent": true
      }
    },
    "creative_director": {
      "provider": "groq",
      "model": "openai/gpt-oss-120b"
    },
    "editor_feasibility_reviewer": {
      "provider": "groq",
      "model": "openai/gpt-oss-20b"
    }
  },
  "editor": {
    "provider": "FilmCraft",
    "version": "0.16.0",
    "linux_x86_64_archive_sha256": "588390eee5d7e1634f05794c4f877ddf29494d9cf74405111d67c16cbe215ae9",
    "no_ffmpeg_or_ffprobe": true,
    "no_alternative_render_fallback": true,
    "effect_receipts_required": true,
    "zero_silent_effect_omissions": true,
    "license": "MIT OR Apache-2.0"
  },
  "delivery": {
    "private_only": true,
    "publish_automatically": false,
    "default_runtime_version": "v5",
    "source_consent_required": true,
    "music_mode": "original_CC0_library_and_verified_openverse_candidates",
    "output_profile": {
      "width": 1080,
      "height": 1920
    }
  }
}
