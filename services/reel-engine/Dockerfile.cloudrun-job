# Private CPU-only Cloud Run Job; separate from the long-running Reel Engine API.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN pip install --no-cache-dir google-cloud-storage==3.17.0
COPY cloudrun_batch.py geo_policy.py multi_renderer.py ./
RUN python -m compileall -q /app
ENV PYTHONUNBUFFERED=1
CMD ["python", "cloudrun_batch.py"]
