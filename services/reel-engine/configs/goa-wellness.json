{
  "brand": "goa-wellness",
  "format": "reel",
  "width": 1080,
  "height": 1920,
  "fps": 30,
  "duration_min": 18,
  "duration_max": 25,
  "opening_hook": {
    "required": true,
    "max_seconds": 2.5
  },
  "ending": {
    "min_hold_seconds": 2.8,
    "cta": "Want the place? Comment ‘GOA’ or DM us",
    "audio_fade_seconds": 1.8,
    "video_fade_seconds": 1.4
  },
  "audio": {
    "music_volume": 0.78,
    "ambient_volume": 0.14,
    "fade_in_seconds": 0.35,
    "fade_out_seconds": 1.8,
    "music_start_seconds": 0,
    "music_library": {
      "auto_select": true,
      "required": false,
      "moods": [
        "serene",
        "organic",
        "premium",
        "wellness",
        "cinematic"
      ],
      "target_bpm": 104,
      "bpm_min": 82,
      "bpm_max": 116,
      "platform": "instagram"
    },
    "beat_sync": {
      "enabled": true,
      "beats_per_cut": 4,
      "min_shot_seconds": 1.2,
      "max_shot_seconds": 3
    }
  },
  "captions": {
    "auto_transcribe": false,
    "burn_subtitles": false,
    "sidecar_srt": true,
    "whisper_model": "base"
  },
  "text": {
    "font": "DejaVuSans-Bold.ttf",
    "position": "center",
    "max_lines": 2
  },
  "qa": {
    "reject_if_end_abrupt": true,
    "reject_if_cta_under_seconds": 2.2,
    "reject_if_source_endcard_detected": true,
    "require_music_fade": true,
    "require_srt": true,
    "require_commercial_music_clearance": true
  },
  "attribution": {
    "enabled": true,
    "label": "Footage"
  }
}
